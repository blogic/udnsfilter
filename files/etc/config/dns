
config main 'main'
	option listen_addr '0.0.0.0'
	option listen_addr6 '::'
	option listen_port '53'
	list upstream 'dns://1.1.1.1'
	list upstream 'dns://8.8.8.8'
	option rotation '1'
	option cache_ttl '3600'
	option filter '1'
	option verbose '0'
	option rebind_protection '1'
	# Security limits; 0 disables a limit. Defaults shown.
	option block_any '1'
	option dns0x20 '0'
	option ratelimit '100'
	option ratelimit_burst '300'
	option ratelimit_global '1000'
	option ratelimit_global_burst '2000'
	option max_pending '2048'
	option max_filter_rules '262144'
	option max_tcp_per_client '8'

config filter 'adguard_dns'
	option enabled '0'
	option name 'AdGuard DNS Filter'
	option url 'https://adguardteam.github.io/AdGuardSDNSFilter/Filters/filter.txt'
	option path '/var/lib/udnsfilter/adguard_dns.txt'

config filter 'stevenblack'
	option enabled '0'
	option name 'StevenBlack Unified Hosts'
	option url 'https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts'
	option path '/var/lib/udnsfilter/stevenblack.txt'

config filter 'easylist'
	option enabled '0'
	option name 'EasyList'
	option url 'https://easylist.to/easylist/easylist.txt'
	option path '/var/lib/udnsfilter/easylist.txt'

config filter 'easyprivacy'
	option enabled '0'
	option name 'EasyPrivacy'
	option url 'https://easylist.to/easylist/easyprivacy.txt'
	option path '/var/lib/udnsfilter/easyprivacy.txt'

config filter 'oisd_small'
	option enabled '0'
	option name 'OISD Small'
	option url 'https://small.oisd.nl/'
	option path '/var/lib/udnsfilter/oisd_small.txt'

config filter 'adaway'
	option enabled '0'
	option name 'AdAway'
	option url 'https://adaway.org/hosts.txt'
	option path '/var/lib/udnsfilter/adaway.txt'

config filter 'fanboy_tracking'
	option enabled '0'
	option name 'Fanboy Enhanced Tracking List'
	option url 'https://secure.fanboy.co.nz/enhancedstats.txt'
	option path '/var/lib/udnsfilter/fanboy_tracking.txt'
