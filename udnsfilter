#!/usr/bin/env ucode
'use strict';

import * as uloop from 'uloop';
import * as ubus from 'ubus';
import * as udnsfilter from 'udnsfilter';
import * as filter from 'udnsfilter.filter';
import * as config_mod from 'udnsfilter.config';
import * as tracking from 'udnsfilter.tracking';
import * as query from 'udnsfilter.query';

let config = config_mod.load(ARGV[0]);

let ubus_conn;
let ubus_obj;

function filters_load() {
	if (!config.filter_enabled)
		return null;

	return filter.load(config.confdir);
}

function ubus_init() {
	ubus_conn = ubus.connect();
	if (!ubus_conn)
		return false;

	ubus_obj = ubus_conn.publish('udnsfilter', {
		stats: {
			call: function(req) {
				let c_stats = udnsfilter.stats_get();
				return {
					total_queries: c_stats.total_queries || 0,
					blocked_queries: c_stats.blocked_queries || 0,
					allowed_queries: c_stats.allowed_queries || 0,
					forwarded_queries: c_stats.forwarded_queries || 0,
					upstream_errors: c_stats.upstream_errors || 0
				};
			},
			args: {}
		},
		reinit: {
			call: function(req) {
				if (!udnsfilter.reinit())
					return { success: false, error: "ares_reinit failed" };

				return { success: true };
			},
			args: {}
		},
		servers: {
			call: function(req) {
				return udnsfilter.get_server_states();
			},
			args: {}
		},
		reload_filter: {
			call: function(req) {
				if (!config.filter_enabled)
					return { success: false, error: "filtering not enabled" };

				let result = filters_load();
				if (!result)
					return { success: false, error: "failed to load filter lists" };

				return {
					success: true,
					rules_loaded: result.total_rules,
					filters: result.loaded_filters
				};
			},
			args: {}
		},
		reset_stats: {
			call: function(req) {
				udnsfilter.stats_reset();
				return { success: true };
			},
			args: {}
		},
		filters: {
			call: function(req) {
				return filter.status() ?? {};
			},
			args: {}
		},
		tracking: {
			call: function(req) {
				let ip = req.args?.ip;
				let enable = req.args?.enable;

				if (!ip)
					return tracking.tracked();

				if (enable) {
					if (!tracking.track(ip))
						return { success: false, error: "too many tracked addresses" };
					return { success: true, tracking: ip };
				}

				tracking.untrack(ip);
				return { success: true, stopped: ip };
			},
			args: {
				ip: "127.0.0.1",
				enable: true
			}
		},
		domains: {
			call: function(req) {
				return tracking.domains();
			},
			args: {}
		}
	});

	return ubus_obj != null;
}

function ubus_cleanup() {
	if (ubus_obj)
		ubus_obj.remove();
	if (ubus_conn)
		ubus_conn.disconnect();
}

function init() {
	printf("Initialising udnsfilter...\n");

	if (!udnsfilter.socket_create(config.listen_addr, config.listen_port,
	                               config.rotation, config.cache_ttl,
	                               config.listen_addr6)) {
		printf("Failed to create socket\n");
		return false;
	}

	printf("Listening on %s:%d and [%s]:%d\n",
	       config.listen_addr, config.listen_port,
	       config.listen_addr6, config.listen_port);
	printf("Server rotation: %J\n", config.rotation);
	printf("Cache TTL: %d seconds\n", config.cache_ttl);

	query.init(config);
	udnsfilter.set_callback('query', query.handle);

	udnsfilter.set_upstream(config.upstream_servers, config.bootstrap);
	printf("Upstream servers: %s\n", join(', ', config.upstream_servers));
	if (config.bootstrap)
		printf("DoH bootstrap: %s\n", config.bootstrap);

	udnsfilter.rebind_protection(config.rebind_protection, config.rebind_domains);

	if (!ubus_init()) {
		printf("Warning: Failed to initialise ubus\n");
	} else {
		printf("ubus interface registered\n");
	}

	if (config.filter_enabled) {
		let result = filters_load();
		if (result)
			printf("Loaded %d filter rules from %d lists\n",
			       result.total_rules, result.loaded_filters);
		else
			printf("Warning: Failed to load filter lists\n");
	}

	return true;
}

function print_stats() {
	let s = udnsfilter.stats_get();

	printf("\n--- Statistics ---\n");
	printf("Total queries: %d\n", s.total_queries);
	printf("Blocked: %d\n", s.blocked_queries);
	printf("Allowed: %d\n", s.allowed_queries);
	printf("Forwarded: %d\n", s.forwarded_queries);
	printf("Upstream errors: %d\n", s.upstream_errors);
	printf("------------------\n\n");
}

function shutdown() {
	printf("\nShutting down...\n");

	print_stats();

	ubus_cleanup();
	udnsfilter.shutdown();

	uloop.end();
}

uloop.init();

if (!init()) {
	printf("Initialisation failed\n");
	exit(1);
}

uloop.signal("SIGINT", shutdown);
uloop.signal("SIGTERM", shutdown);

uloop.interval(30000, print_stats);

printf("uDNS Filter started.\n");

if (!udnsfilter.drop_privileges()) {
	printf("Warning: Failed to drop privileges\n");
} else {
	printf("Privileges dropped\n");
}

uloop.run();
