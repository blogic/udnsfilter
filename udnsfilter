#!/usr/bin/env ucode
'use strict';

import * as uloop from 'uloop';
import * as ubus from 'ubus';
import * as uci from 'uci';
import * as udnsfilter from 'udnsfilter';
import * as filter from 'udnsfilter.filter';

const uci_dir = ARGV[0];

let config = {
	listen_addr: '0.0.0.0',
	listen_addr6: '::',
	listen_port: 53,
	upstream_servers: [ 'dns://8.8.8.8' ],
	bootstrap: null,
	filter_enabled: true,
	rotation: true,
	cache_ttl: 3600,
	verbose: false,
	rebind_protection: true,
	rebind_domains: [],
};

const DOMAIN_MAP_MAX = 4096;
const TRACKED_IPS_MAX = 32;

let ubus_conn;
let ubus_obj;

let tracked_ips = {};
let global_domains = { replied: {}, blocked: {} };

function domain_count(owner, key, domain) {
	let map = owner[key];

	/* Reset a full map instead of evicting: these are diagnostic
	 * counters and a per-query scan under a random-subdomain flood
	 * would cost more than the history is worth. */
	if (map[domain] == null && length(map) >= DOMAIN_MAP_MAX)
		map = owner[key] = {};

	if (!map[domain])
		map[domain] = 0;
	map[domain]++;
}

function config_bool(value, fallback) {
	if (value == null)
		return fallback;

	return value == '1' || value == 'true' || value == 'on' || value == 'yes';
}

function config_list(value, fallback) {
	if (type(value) == 'array')
		return value;
	if (type(value) == 'string')
		return [ value ];

	return fallback;
}

function config_load() {
	let cursor = uci.cursor(uci_dir);

	if (!cursor || !cursor.load('dns'))
		return;

	let main = cursor.get_all('dns', 'main');
	if (!main)
		return;

	config.listen_addr = main.listen_addr ?? config.listen_addr;
	config.listen_addr6 = main.listen_addr6 ?? config.listen_addr6;
	config.listen_port = int(main.listen_port ?? config.listen_port);
	config.bootstrap = main.bootstrap;
	config.cache_ttl = int(main.cache_ttl ?? config.cache_ttl);
	config.rotation = config_bool(main.rotation, config.rotation);
	config.filter_enabled = config_bool(main.filter, config.filter_enabled);
	config.verbose = config_bool(main.verbose, config.verbose);
	config.rebind_protection = config_bool(main.rebind_protection, config.rebind_protection);
	config.upstream_servers = config_list(main.upstream, config.upstream_servers);
	config.rebind_domains = config_list(main.rebind_domain, config.rebind_domains);
}

function filters_load() {
	if (!config.filter_enabled)
		return null;

	return filter.load(uci_dir);
}

function ubus_init() {
	ubus_conn = ubus.connect();
	if (!ubus_conn)
		return false;

	ubus_obj = ubus_conn.publish('udnsfilter', {
		stats: {
			call: function(req) {
				let c_stats = udnsfilter.stats_get();
				return {
					total_queries: c_stats.total_queries || 0,
					blocked_queries: c_stats.blocked_queries || 0,
					allowed_queries: c_stats.allowed_queries || 0,
					forwarded_queries: c_stats.forwarded_queries || 0,
					upstream_errors: c_stats.upstream_errors || 0
				};
			},
			args: {}
		},
		reinit: {
			call: function(req) {
				if (!udnsfilter.reinit())
					return { success: false, error: "ares_reinit failed" };

				return { success: true };
			},
			args: {}
		},
		servers: {
			call: function(req) {
				return udnsfilter.get_server_states();
			},
			args: {}
		},
		reload_filter: {
			call: function(req) {
				if (!config.filter_enabled)
					return { success: false, error: "filtering not enabled" };

				let result = filters_load();
				if (!result)
					return { success: false, error: "failed to load filter lists" };

				return {
					success: true,
					rules_loaded: result.total_rules,
					filters: result.loaded_filters
				};
			},
			args: {}
		},
		reset_stats: {
			call: function(req) {
				udnsfilter.stats_reset();
				return { success: true };
			},
			args: {}
		},
		tracking: {
			call: function(req) {
				let ip = req.args?.ip;
				let enable = req.args?.enable;

				if (!ip) {
					let result = {};
					for (let tracked_ip in tracked_ips) {
						result[tracked_ip] = tracked_ips[tracked_ip];
					}
					return result;
				}

				if (enable) {
					if (!tracked_ips[ip]) {
						if (length(tracked_ips) >= TRACKED_IPS_MAX)
							return { success: false, error: "too many tracked addresses" };
						tracked_ips[ip] = { replied: {}, blocked: {} };
					}
					return { success: true, tracking: ip };
				} else {
					if (tracked_ips[ip])
						delete tracked_ips[ip];
					return { success: true, stopped: ip };
				}
			},
			args: {
				ip: "127.0.0.1",
				enable: true
			}
		},
		domains: {
			call: function(req) {
				return global_domains;
			},
			args: {}
		}
	});

	return ubus_obj != null;
}

function ubus_cleanup() {
	if (ubus_obj)
		ubus_obj.remove();
	if (ubus_conn)
		ubus_conn.disconnect();
}

function handle_query(packet, client_addr) {
	if (!packet.questions || length(packet.questions) == 0)
		return;

	let domain = packet.questions[0].name;
	let client_ip = client_addr.address;

	if (config.verbose)
		printf("Query from %s:%d: %s\n", client_ip, client_addr.port, domain);

	if (config.filter_enabled && domain) {
		let result = udnsfilter.filter_match(domain);
		if (result && result.blocked) {
			if (config.verbose)
				printf("BLOCKED: %s (rule: %s)\n", domain, result.rule);

			domain_count(global_domains, 'blocked', domain);
			if (tracked_ips[client_ip])
				domain_count(tracked_ips[client_ip], 'blocked', domain);

			udnsfilter.send_blocked_response(client_addr, packet);
			return;
		}
	}

	domain_count(global_domains, 'replied', domain);
	if (tracked_ips[client_ip])
		domain_count(tracked_ips[client_ip], 'replied', domain);

	udnsfilter.forward_query(client_addr, packet);
}

function init() {
	printf("Initialising udnsfilter...\n");

	if (!udnsfilter.socket_create(config.listen_addr, config.listen_port,
	                               config.rotation, config.cache_ttl,
	                               config.listen_addr6)) {
		printf("Failed to create socket\n");
		return false;
	}

	printf("Listening on %s:%d and [%s]:%d\n",
	       config.listen_addr, config.listen_port,
	       config.listen_addr6, config.listen_port);
	printf("Server rotation: %J\n", config.rotation);
	printf("Cache TTL: %d seconds\n", config.cache_ttl);

	udnsfilter.set_callback('query', handle_query);

	udnsfilter.set_upstream(config.upstream_servers, config.bootstrap);
	printf("Upstream servers: %s\n", join(', ', config.upstream_servers));
	if (config.bootstrap)
		printf("DoH bootstrap: %s\n", config.bootstrap);

	udnsfilter.rebind_protection(config.rebind_protection, config.rebind_domains);

	if (!ubus_init()) {
		printf("Warning: Failed to initialise ubus\n");
	} else {
		printf("ubus interface registered\n");
	}

	if (config.filter_enabled) {
		let result = filters_load();
		if (result)
			printf("Loaded %d filter rules from %d lists\n",
			       result.total_rules, result.loaded_filters);
		else
			printf("Warning: Failed to load filter lists\n");
	}

	return true;
}

function print_stats() {
	let s = udnsfilter.stats_get();

	printf("\n--- Statistics ---\n");
	printf("Total queries: %d\n", s.total_queries);
	printf("Blocked: %d\n", s.blocked_queries);
	printf("Allowed: %d\n", s.allowed_queries);
	printf("Forwarded: %d\n", s.forwarded_queries);
	printf("Upstream errors: %d\n", s.upstream_errors);
	printf("------------------\n\n");
}

function shutdown() {
	printf("\nShutting down...\n");

	print_stats();

	ubus_cleanup();
	udnsfilter.shutdown();

	uloop.end();
}

uloop.init();

config_load();

if (!init()) {
	printf("Initialisation failed\n");
	exit(1);
}

uloop.signal("SIGINT", shutdown);
uloop.signal("SIGTERM", shutdown);

uloop.interval(30000, print_stats);

printf("uDNS Filter started.\n");

if (!udnsfilter.drop_privileges()) {
	printf("Warning: Failed to drop privileges\n");
} else {
	printf("Privileges dropped\n");
}

uloop.run();
